# tinyvmm Firecracker-style kernel config delta
#
# Audited against the IKCONFIG blob embedded in the user's
# vmlinux (Linux 7.0.0, muks@llm build). Every line below
# proposes a change FROM the user's CURRENT state TO the
# tinyvmm-optimized target. Items already at the desired
# state are listed in a comment-only section at the end so
# you can sanity-check.
#
# Apply via:
#   scripts/kconfig/merge_config.sh -m .config tinyvmm.frag
#   make ARCH=x86_64 olddefconfig
#
# Expected gains (cumulative, layered on top of the existing
# --pvh-run defaults that already skip earlyprintk):
#   vmlinux stripped:  18 MB  ->  ~6-8 MB
#   entering-guest -> first-hvc0-byte: 352 ms -> ~80-120 ms
#   .text:             10.6 MB -> ~5-6 MB

# ===========================================================
# A. SMP off -- biggest single boot-time win.
#    Currently you have SMP=y, NR_CPUS=8, HOTPLUG_CPU=y,
#    X86_X2APIC=y. tinyvmm only ever creates 1 vCPU.
# ===========================================================
# CONFIG_SMP is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_X86_X2APIC is not set
# CONFIG_SCHED_AUTOGROUP is not set       # currently =y; useless for 1-vCPU

# ===========================================================
# B. PREEMPT off
#    Currently: PREEMPT_LAZY=y, PREEMPTION=y. Switch to NONE
#    for throughput; microvm doesn't need low-latency wakeup.
# ===========================================================
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT_LAZY is not set
# CONFIG_PREEMPTION is not set

# ===========================================================
# C. KASLR off
#    Currently all three are =y. KASLR adds PRNG init wait
#    and per-boot relocation. Inside a microvm you own, the
#    isolation comes from the VMM, not the guest's ASLR.
# ===========================================================
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RANDOMIZE_MEMORY is not set
# CONFIG_RANDOMIZE_KSTACK_OFFSET is not set

# ===========================================================
# D. Netfilter family -- entirely =y today; entirely off for
#    tinyvmm. The 30+ NF_* / NETFILTER_* / NF_CONNTRACK_*
#    symbols all flip via this top-level disable.
# ===========================================================
# CONFIG_NETFILTER is not set
# CONFIG_NF_CONNTRACK is not set
# CONFIG_NF_TABLES is not set
# CONFIG_NF_NAT is not set
# CONFIG_NETFILTER_NETLINK is not set
# CONFIG_NF_LOG_SYSLOG is not set

# ===========================================================
# E. IPv6, TLS, advanced TCP -- all =y. tinyvmm's NAT and
#    tests are IPv4-only; kernel default tcp_cubic is fine.
# ===========================================================
# CONFIG_IPV6 is not set
# CONFIG_TLS is not set
# CONFIG_TCP_CONG_ADVANCED is not set     # drops BBR + friends

# ===========================================================
# F. Filesystems -- currently EXT4, FUSE (+ PASSTHROUGH +
#    IO_URING), OVERLAY (+ REDIRECT_ALWAYS_FOLLOW + INDEX),
#    VIRTIO_FS are all =y. Drop everything you don't actually
#    mount. For pure initramfs workloads, even EXT4 can go.
# ===========================================================
# CONFIG_EXT4_FS is not set               # keep =y ONLY if mounting disk
# CONFIG_FUSE_FS is not set
# CONFIG_FUSE_PASSTHROUGH is not set
# CONFIG_FUSE_IO_URING is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW is not set
# CONFIG_OVERLAY_FS_INDEX is not set
# CONFIG_VIRTIO_FS is not set
# CONFIG_FANOTIFY is not set               # =y today; busybox doesn't use it
# CONFIG_INOTIFY_USER is not set           # =y today; same reason

# ===========================================================
# G. virtio: keep what tinyvmm presents, drop the rest.
#    Currently on: VIRTIO_PCI=y, VIRTIO_PCI_LIB=y,
#    VIRTIO_PCI_LIB_LEGACY=y, VIRTIO_PCI_LEGACY=y,
#    VIRTIO_PCI_ADMIN_LEGACY=y, VIRTIO_MMIO=y,
#    VIRTIO_MMIO_CMDLINE_DEVICES=y, VIRTIO_RTC=y,
#    VSOCKETS=y, VIRTIO_VSOCKETS_COMMON=y.
#    Keep ONLY modern PCI + BLK/NET/CONSOLE + virtio-RNG.
# ===========================================================
# CONFIG_VIRTIO_PCI_LEGACY is not set
# CONFIG_VIRTIO_PCI_LIB_LEGACY is not set
# CONFIG_VIRTIO_PCI_ADMIN_LEGACY is not set
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
# CONFIG_VIRTIO_RTC is not set
# CONFIG_VIRTIO_RTC_PTP is not set
# CONFIG_VIRTIO_RTC_CLASS is not set
# CONFIG_VSOCKETS is not set
# CONFIG_VIRTIO_VSOCKETS_COMMON is not set

# ===========================================================
# H. Subsystems tinyvmm guests never need
# ===========================================================
# CONFIG_BPF_SYSCALL is not set            # =y today; only if you load eBPF
# CONFIG_BPF is not set
# CONFIG_CGROUPS is not set                # =y today; only if init uses them
# CONFIG_NAMESPACES is not set             # =y today; container init only
# CONFIG_MEMCG is not set                  # =y today; cgroup memory ctrl
# CONFIG_KALLSYMS is not set               # =y today; ~1-2 MB savings, oops loses symbols
# CONFIG_PERF_EVENTS is not set            # =y today
# CONFIG_KEYS is not set                   # =y today; not used in guest
# CONFIG_MICROCODE is not set              # =y today; we don't load CPU ucode in guest
# CONFIG_FW_LOADER is not set              # =y today; no firmware-loading drivers
# CONFIG_RTC_CLASS is not set              # =y today; tinyvmm has no MC146818
# CONFIG_CPU_IDLE is not set               # =y today; default_idle (HLT) is enough
# CONFIG_INPUT is not set                  # =y today; no keyboard/mouse in guest
# CONFIG_TTY_PRINTK is not set             # =y today
# CONFIG_DEBUG_KERNEL is not set           # =y today; only enables the menu
# CONFIG_INIT_STACK_ALL_ZERO is not set    # =y today; perf cost on hot paths

# ===========================================================
# I. Frame pointers off -- currently y + UNWINDER_FRAME_POINTER=y.
#    ORC unwinder is the modern choice; saves ~5% perf and
#    a chunk of .text. Trade-off: harder to read live stack
#    traces with custom tools, but kernel oops still works.
# ===========================================================
# CONFIG_FRAME_POINTER is not set
# CONFIG_UNWINDER_FRAME_POINTER is not set
CONFIG_UNWINDER_ORC=y

# ===========================================================
# J. Indirect Branch Tracking off -- IBT adds ENDBR64 to every
#    indirect call target. tinyvmm guest is single-tenant; the
#    perf cost is non-trivial. Off only if you trust your guest.
# ===========================================================
# CONFIG_X86_KERNEL_IBT is not set         # =y today

# ===========================================================
# K. Timer: 100 Hz vs 250 Hz. Tiny win but consistent with
#    Firecracker. NO_HZ_IDLE=y you already have.
# ===========================================================
# CONFIG_HZ_250 is not set
CONFIG_HZ_100=y
CONFIG_HZ=100

# ===========================================================
# L. 8250: keep one UART (you have 4), drop PCI-attached UART
#    scanning entirely.
# ===========================================================
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_PCI is not set         # =y today; tinyvmm has no PCI UART

# ===========================================================
# M. PCI: drop AER, port bus, quirks. tinyvmm devices are
#    well-behaved virtio with no quirks; no AER root port.
#    PCI_MSI stays on -- we use MSI-X for doorbell completions.
# ===========================================================
# CONFIG_PCIEAER is not set                 # =y today
# CONFIG_PCIEPORTBUS is not set             # =y today
# CONFIG_PCI_QUIRKS is not set              # =y today

# ===========================================================
# N. Initramfs decompressor -- you currently have RD_XZ=y but
#    tinyvmm's tools/make_initramfs.py ships uncompressed cpio.
#    Drop XZ; trim ~100 KB of code.
# ===========================================================
# CONFIG_RD_XZ is not set

# ===========================================================
# O. NR_CPUS: only relevant if you keep SMP=y. With SMP=n it's
#    forced to 1 by the kconfig. If you choose to keep SMP for
#    some reason, at least:
#       CONFIG_NR_CPUS=1
# ===========================================================

# -----------------------------------------------------------
# REQUIRED -- DO NOT TOUCH (already correct in your config):
#   CONFIG_PVH=y                  # tinyvmm uses PVH boot
#   CONFIG_BLK_DEV_INITRD=y       # we ship initramfs.cpio
#   CONFIG_DEVTMPFS=y / _MOUNT=y
#   CONFIG_TMPFS=y / PROC_FS=y / SYSFS=y
#   CONFIG_NET=y / INET=y / UNIX=y
#   CONFIG_VIRTIO=y / VIRTIO_PCI=y / VIRTIO_PCI_LIB=y
#   CONFIG_VIRTIO_NET=y / VIRTIO_BLK=y / VIRTIO_CONSOLE=y
#   CONFIG_HW_RANDOM=y / HW_RANDOM_VIRTIO=y
#   CONFIG_PCI=y / PCI_MSI=y      # we use MSI-X
#   CONFIG_PRINTK=y / EARLY_PRINTK=y / SERIAL_8250=y / _CONSOLE=y
#       (kept for --debug-boot diagnostics)

# -----------------------------------------------------------
# ALREADY OFF in your config (no change needed):
#   CONFIG_ACPI                # was NOT-SET; tinyvmm has PIT fallback
#   CONFIG_MODULES             # NOT-SET
#   CONFIG_KEXEC               # NOT-SET
#   CONFIG_FTRACE              # NOT-SET
#   CONFIG_KPROBES             # NOT-SET
#   CONFIG_PROFILING           # NOT-SET
#   CONFIG_AUDIT               # NOT-SET
#   CONFIG_NUMA                # NOT-SET
#   CONFIG_TRANSPARENT_HUGEPAGE# NOT-SET
#   CONFIG_CMA                 # NOT-SET
#   CONFIG_SUSPEND / PM / PM_SLEEP / HIBERNATION  # all NOT-SET / ABSENT
#   CONFIG_CPU_FREQ            # NOT-SET   (USER WAS RIGHT)
#   CONFIG_THERMAL             # NOT-SET
#   CONFIG_WATCHDOG            # NOT-SET
#   CONFIG_VIRTIO_BALLOON      # NOT-SET
#   CONFIG_VIRTIO_INPUT        # NOT-SET
#   CONFIG_VIRTIO_VSOCKETS     # NOT-SET   (but VSOCKETS=y still ON -- see G)
#   CONFIG_BRIDGE              # NOT-SET
#   CONFIG_VLAN_8021Q          # NOT-SET
#   CONFIG_IP_NF_IPTABLES      # NOT-SET   (covered by NETFILTER=n anyway)
#   CONFIG_BTRFS_FS / XFS_FS / F2FS_FS / 9P_FS / NFS_FS  # all off
#   CONFIG_QUOTA               # NOT-SET
#   CONFIG_SOUND               # NOT-SET
#   CONFIG_USB                 # not enabled (only OHCI endian symbol)
#   CONFIG_SCSI                # only SCSI_MOD=y for block layer helper
#   CONFIG_HALT_POLL           # ABSENT (KVM-host concept)
#   CONFIG_KASAN / UBSAN / LOCKDEP / RETPOLINE  # ABSENT or NOT-SET
#   CONFIG_DEBUG_INFO          # ABSENT  <-- but 55 MB of .debug_* is
#                                still in your vmlinux. Source: gcc's
#                                default -g flag, not Kconfig. Either
#                                build with `make KCFLAGS="-O2"` to
#                                skip debug-info generation, or rely
#                                on `strip --strip-all vmlinux`
#                                (current behavior: 78 MB -> 18 MB).
